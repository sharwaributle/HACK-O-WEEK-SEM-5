def matrix_page():

    clear_page()

    heading(
        "Matrix Workspace",
        "Multiply two 2 × 2 matrices using NumPy"
    )

    container = tk.Frame(
        page_area,
        bg=BG
    )

    container.pack(
        fill="both",
        expand=True
    )

    left = card(container)

    left.pack(
        side="left",
        fill="y",
        padx=(0, 10)
    )

    right = card(container)

    right.pack(
        side="right",
        fill="both",
        expand=True,
        padx=(10, 0)
    )

    def create_matrix(parent, title_text, defaults):

        tk.Label(
            parent,
            text=title_text,
            font=("Segoe UI", 13, "bold"),
            bg=WHITE,
            fg=PURPLE
        ).pack(
            pady=(25, 12)
        )

        fields = []

        grid = tk.Frame(
            parent,
            bg=WHITE
        )

        grid.pack(
            padx=25,
            pady=10
        )

        for i in range(2):

            row = []

            for j in range(2):

                entry = input_box(
                    grid,
                    str(defaults[i][j])
                )

                entry.grid(
                    row=i,
                    column=j,
                    padx=5,
                    pady=5
                )

                row.append(entry)

            fields.append(row)

        return fields

    matrix_a = create_matrix(
        left,
        "MATRIX A",
        [[1, 2], [2, 3]]
    )

    matrix_b = create_matrix(
        left,
        "MATRIX B",
        [[5, 6], [6, 7]]
    )

    def multiply():

        try:

            A = np.array([
                [
                    float(matrix_a[i][j].get())
                    for j in range(2)
                ]
                for i in range(2)
            ])

            B = np.array([
                [
                    float(matrix_b[i][j].get())
                    for j in range(2)
                ]
                for i in range(2)
            ])

            C = MathEngine.matrix_product(A, B)

            result.config(
                text=(
                    "MATRIX MULTIPLICATION\n"
                    "────────────────────────\n\n"
                    f"Matrix A:\n{A}\n\n"
                    f"Matrix B:\n{B}\n\n"
                    f"A × B:\n{C}"
                )
            )

        except ValueError:

            messagebox.showerror(
                "Input Error",
                "Enter valid numbers in all matrix cells."
            )

    action_button(
        left,
        "MULTIPLY",
        multiply
    ).pack(
        pady=25
    )

    tk.Label(
        right,
        text="OUTPUT",
        font=("Segoe UI", 12, "bold"),
        bg=WHITE,
        fg=TEXT
    ).pack(
        anchor="w",
        padx=22,
        pady=(20, 0)
    )

    result = output_box(
        right,
        "Matrix multiplication result will appear here."
    )


