def vector_page():

    clear_page()

    heading(
        "Vector Laboratory",
        "Calculate vector addition, dot product and magnitude"
    )

    workspace = tk.Frame(
        page_area,
        bg=BG
    )

    workspace.pack(
        fill="both",
        expand=True
    )

    # --------------------------------------------------------
    # INPUT PANEL
    # --------------------------------------------------------

    inputs = card(workspace)

    inputs.pack(
        side="left",
        fill="y",
        padx=(0, 10)
    )

    tk.Label(
        inputs,
        text="VECTOR INPUT",
        font=("Segoe UI", 11, "bold"),
        bg=WHITE,
        fg=PURPLE
    ).pack(
        pady=(25, 18),
        padx=30
    )

    entries = {}

    for vector_name, color in [
        ("Vector A", PURPLE),
        ("Vector B", CYAN)
    ]:

        tk.Label(
            inputs,
            text=vector_name,
            font=("Segoe UI", 13, "bold"),
            bg=WHITE,
            fg=color
        ).pack(
            pady=(8, 5)
        )

        row = tk.Frame(
            inputs,
            bg=WHITE
        )

        row.pack(pady=5)

        x_entry = input_box(
            row,
            "3" if vector_name == "Vector A" else "2"
        )

        y_entry = input_box(
            row,
            "4" if vector_name == "Vector A" else "1"
        )

        x_entry.pack(
            side="left",
            padx=4
        )

        y_entry.pack(
            side="left",
            padx=4
        )

        entries[vector_name] = (x_entry, y_entry)

    def calculate():

        try:

            ax, ay = entries["Vector A"]
            bx, by = entries["Vector B"]

            A = np.array([
                float(ax.get()),
                float(ay.get())
            ])

            B = np.array([
                float(bx.get()),
                float(by.get())
            ])

            addition, dot, mag_a, mag_b = (
                MathEngine.vector_calculation(A, B)
            )

            result.config(
                text=(
                    "VECTOR RESULT\n"
                    "────────────────────────\n\n"
                    f"A + B = {addition}\n\n"
                    f"A · B = {dot:.2f}\n\n"
                    f"|A| = {mag_a:.2f}\n\n"
                    f"|B| = {mag_b:.2f}\n"
                )
            )

        except ValueError:

            messagebox.showerror(
                "Input Error",
                "Please enter numeric values."
            )

    action_button(
        inputs,
        "CALCULATE VECTOR",
        calculate
    ).pack(
        pady=25
    )

    # --------------------------------------------------------
    # RESULT PANEL
    # --------------------------------------------------------

    result_card = card(workspace)

    result_card.pack(
        side="right",
        fill="both",
        expand=True,
        padx=(10, 0)
    )

    tk.Label(
        result_card,
        text="RESULT",
        font=("Segoe UI", 12, "bold"),
        bg=WHITE,
        fg=TEXT
    ).pack(
        anchor="w",
        padx=22,
        pady=(20, 0)
    )

    result = output_box(
        result_card,
        "Enter values and press Calculate."
    )


