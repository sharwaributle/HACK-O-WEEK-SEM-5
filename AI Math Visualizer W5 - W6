def card(parent, width=None):

    frame = tk.Frame(
        parent,
        bg=WHITE,
        highlightbackground=BORDER,
        highlightthickness=1
    )

    if width:
        frame.config(width=width)

    return frame


def output_box(parent, text=""):

    result = tk.Label(
        parent,
        text=text,
        font=("Consolas", 11),
        bg="#F8FAFC",
        fg=TEXT,
        justify="left",
        anchor="nw",
        padx=20,
        pady=18
    )

    result.pack(
        fill="both",
        expand=True,
        padx=18,
        pady=18
    )

    return result


def action_button(parent, text, command, color=PURPLE):

    return tk.Button(
        parent,
        text=text,
        command=command,
        font=("Segoe UI", 10, "bold"),
        bg=color,
        fg=WHITE,
        activebackground=color,
        activeforeground=WHITE,
