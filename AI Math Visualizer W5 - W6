# ============================================================
# MATHEMATICAL ENGINE
# ============================================================

class MathEngine:

    @staticmethod
    def vector_calculation(a, b):

        addition = a + b
        dot_product = np.dot(a, b)

        magnitude_a = np.linalg.norm(a)
        magnitude_b = np.linalg.norm(b)

        return addition, dot_product, magnitude_a, magnitude_b

    @staticmethod
    def matrix_product(a, b):

        return np.matmul(a, b)

    @staticmethod
    def eigen_calculation(matrix):

        return np.linalg.eig(matrix)

    @staticmethod
    def derivative(function):

        x = sp.symbols("x")

        expression = sp.sympify(function)

        return expression, sp.diff(expression, x)

    @staticmethod
    def gradient(function):

        x, y = sp.symbols("x y")

        expression = sp.sympify(function)

        dx = sp.diff(expression, x)
        dy = sp.diff(expression, y)

        return expression, dx, dy


