def chain_page():

    clear_page()

    heading(
        "Chain Rule Simulator",
        "Understand the mathematical idea behind backpropagation"
    )

    panel = card(page_area)

    panel.pack(
        fill="both",
        expand=True
    )

    explanation = """
Consider the functions:

z = x²

y = 3z

Using the chain rule:

dy/dx = (dy/dz) × (dz/dx)

dy/dz = 3

dz/dx = 2x
"""

    tk.Label(
        panel,
        text=explanation,
        font=("Consolas", 12),
        bg=WHITE,
        fg=TEXT,
        justify="left"
    ).pack(
        pady=(25, 15)
    )

    row = tk.Frame(
        panel,
        bg=WHITE
    )

    row.pack(
        pady=10
    )

    tk.Label(
        row,
        text="Enter x:",
        font=("Segoe UI", 11, "bold"),
        bg=WHITE,
        fg=TEXT
    ).pack(
        side="left",
        padx=8
    )

    x_entry = input_box(
        row,
        "2"
    )

    x_entry.pack(
        side="left"
    )

    def calculate():

        try:

            x_value = float(
                x_entry.get().strip()
            )

            z_value = x_value ** 2
            y_value = 3 * z_value

            dz_dx = 2 * x_value
            dy_dz = 3
            dy_dx = dy_dz * dz_dx

            result.config(
                text=(
                    "CHAIN RULE RESULT\n"
                    "────────────────────────\n\n"
                    f"x = {x_value}\n\n"
                    f"z = x² = {z_value}\n\n"
                    f"y = 3z = {y_value}\n\n"
                    f"dz/dx = 2x = {dz_dx}\n\n"
                    f"dy/dz = {dy_dz}\n\n"
                    f"dy/dx = (dy/dz) × (dz/dx)\n"
                    f"dy/dx = {dy_dx}\n\n"
                    "The chain rule combines derivatives\n"
                    "from different stages of a computation.\n\n"
                    "Neural networks use this principle\n"
                    "during backpropagation."
                )
            )

        except ValueError:

            messagebox.showerror(
                "Input Error",
                "Please enter a number."
            )

    action_button(
        panel,
        "TRACE GRADIENT",
        calculate,
        "#C2410C"
    ).pack(
        pady=15
    )

    result = output_box(
        panel,
        "Chain rule calculation will appear here."
    )


