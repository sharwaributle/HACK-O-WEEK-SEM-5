page_window = page_canvas.create_window(
    (0, 0),
    window=page_area,
    anchor="nw"
)

page_canvas.configure(
    yscrollcommand=page_scrollbar.set
)

page_canvas.pack(
    side="left",
    fill="both",
    expand=True
)

page_scrollbar.pack(
    side="right",
    fill="y"
)


def update_scroll_region(event=None):

    page_canvas.configure(
        scrollregion=page_canvas.bbox("all")
    )


def resize_page_area(event):

    page_canvas.itemconfig(
        page_window,
        width=event.width
    )

    page_canvas.configure(
        scrollregion=page_canvas.bbox("all")
    )


page_area.bind(
    "<Configure>",
    update_scroll_region
)

page_canvas.bind(
    "<Configure>",
    resize_page_area
)


def mouse_wheel(event):

    page_canvas.yview_scroll(
        int(-1 * (event.delta / 120)),
        "units"
    )


page_canvas.bind_all(
    "<MouseWheel>",
    mouse_wheel
)


