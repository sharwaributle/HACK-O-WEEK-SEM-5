# ============================================================
# DIMENSIONALITY REDUCTION
# PCA (Principal Component Analysis) + t-SNE
# ============================================================

# Required libraries:
# pip install numpy pandas matplotlib scikit-learn

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.datasets import load_iris
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.manifold import TSNE


# ============================================================
# 1. LOAD DATASET
# ============================================================

# Iris dataset contains 4 features:
# Sepal Length, Sepal Width, Petal Length, Petal Width

iris = load_iris()

X = iris.data
y = iris.target

feature_names = iris.feature_names
target_names = iris.target_names

print("Original Dataset Shape:", X.shape)
print("Features:", feature_names)
print("Classes:", target_names)


# ============================================================
# 2. CONVERT DATA INTO DATAFRAME
# ============================================================

df = pd.DataFrame(X, columns=feature_names)
df["Target"] = y

print("\nFirst 5 rows:")
print(df.head())


# ============================================================
# 3. STANDARDIZE THE DATA
# ============================================================

# PCA and t-SNE work better when features are on a
# comparable scale.

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)

print("\nScaled Data:")
print(X_scaled[:5])


# ============================================================
# 4. PCA - DIMENSIONALITY REDUCTION
# ============================================================

# Original data has 4 dimensions.
# We reduce it to 2 principal components.

pca = PCA(n_components=2)

X_pca = pca.fit_transform(X_scaled)

print("\nPCA Result Shape:", X_pca.shape)


# ============================================================
# 5. EXPLAINED VARIANCE
# ============================================================

print("\nExplained Variance Ratio:")
print(pca.explained_variance_ratio_)

print("\nTotal Variance Explained:")
print(sum(pca.explained_variance_ratio_))


# ============================================================
# 6. PCA COMPONENTS
# ============================================================

print("\nPrincipal Components:")
print(pca.components_)


# ============================================================
# 7. VISUALIZE PCA RESULT
# ============================================================

plt.figure(figsize=(8, 6))

for i, target_name in enumerate(target_names):

    plt.scatter(
        X_pca[y == i, 0],
        X_pca[y == i, 1],
        label=target_name
    )

plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.title("PCA - 2D Visualization")
plt.legend()
plt.grid(True)

plt.show()


# ============================================================
# 8. PCA EXPLAINED VARIANCE GRAPH
# ============================================================

# Calculate PCA for all components to see how much
# variance each component explains.

pca_full = PCA()

X_pca_full = pca_full.fit_transform(X_scaled)

explained_variance = pca_full.explained_variance_ratio_

print("\nVariance explained by each component:")
for i, value in enumerate(explained_variance):
    print(f"PC{i + 1}: {value:.4f}")


plt.figure(figsize=(8, 5))

plt.bar(
    range(1, len(explained_variance) + 1),
    explained_variance
)

plt.xlabel("Principal Component")
plt.ylabel("Explained Variance Ratio")
plt.title("PCA Explained Variance")

plt.xticks(range(1, len(explained_variance) + 1))
plt.grid(axis="y")

plt.show()


# ============================================================
# 9. CUMULATIVE EXPLAINED VARIANCE
# ============================================================

cumulative_variance = np.cumsum(explained_variance)

print("\nCumulative Explained Variance:")
for i, value in enumerate(cumulative_variance):
    print(f"PC1-PC{i + 1}: {value:.4f}")


plt.figure(figsize=(8, 5))

plt.plot(
    range(1, len(cumulative_variance) + 1),
    cumulative_variance,
    marker="o"
)

plt.xlabel("Number of Principal Components")
plt.ylabel("Cumulative Explained Variance")
plt.title("Cumulative Explained Variance")

plt.xticks(range(1, len(cumulative_variance) + 1))
plt.grid(True)

plt.show()


# ============================================================
# 10. t-SNE - NON-LINEAR DIMENSIONALITY REDUCTION
# ============================================================

# t-SNE reduces high-dimensional data to 2 dimensions
# while trying to preserve local similarities.

tsne = TSNE(
    n_components=2,
    perplexity=30,
    random_state=42
)

X_tsne = tsne.fit_transform(X_scaled)

print("\nt-SNE Result Shape:", X_tsne.shape)


# ============================================================
# 11. VISUALIZE t-SNE RESULT
# ============================================================

plt.figure(figsize=(8, 6))

for i, target_name in enumerate(target_names):

    plt.scatter(
        X_tsne[y == i, 0],
        X_tsne[y == i, 1],
        label=target_name
    )

plt.xlabel("t-SNE Dimension 1")
plt.ylabel("t-SNE Dimension 2")
plt.title("t-SNE - 2D Visualization")
plt.legend()
plt.grid(True)

plt.show()


# ============================================================
# 12. PCA VS t-SNE COMPARISON
# ============================================================

fig, axes = plt.subplots(1, 2, figsize=(14, 6))


# PCA plot
for i, target_name in enumerate(target_names):

    axes[0].scatter(
        X_pca[y == i, 0],
        X_pca[y == i, 1],
        label=target_name
    )

axes[0].set_title("PCA")
axes[0].set_xlabel("Principal Component 1")
axes[0].set_ylabel("Principal Component 2")
axes[0].grid(True)


# t-SNE plot
for i, target_name in enumerate(target_names):

    axes[1].scatter(
        X_tsne[y == i, 0],
        X_tsne[y == i, 1],
        label=target_name
    )

axes[1].set_title("t-SNE")
axes[1].set_xlabel("t-SNE Dimension 1")
axes[1].set_ylabel("t-SNE Dimension 2")
axes[1].grid(True)

axes[1].legend()

plt.suptitle("PCA vs t-SNE")
plt.tight_layout()

plt.show()


# ============================================================
# 13. FINAL SUMMARY
# ============================================================

print("\n================ FINAL SUMMARY ================")

print("Original dimensions:", X.shape[1])
print("PCA dimensions:", X_pca.shape[1])
print("t-SNE dimensions:", X_tsne.shape[1])

print(
    "\nPCA reduces dimensions by finding directions "
    "with maximum variance."
)

print(
    "t-SNE reduces dimensions mainly for visualization "
    "by preserving local similarities between data points."
)
