def matplotlib_graph():

    df = analytics.add_average()

    plt.figure(
        figsize=(9, 5),
        facecolor="white"
    )

    plt.plot(
        df["Student"],
        df["Average"],
        marker="o",
        linewidth=2.5,
        color="#6D28D9"
    )

    plt.title(
        "Student Average Performance",
        fontsize=15,
        fontweight="bold"
    )

    plt.xlabel("Student")
    plt.ylabel("Average Marks")

    plt.xticks(rotation=25)

    plt.grid(
        axis="y",
        alpha=0.25
    )

    plt.tight_layout()

    plt.show()


