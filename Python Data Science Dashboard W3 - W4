# ============================================================
# DATA HANDLING CLASS
# ============================================================

class StudentAnalytics:

    def __init__(self):
        self.student_data = pd.DataFrame({
            "Student ID": [101, 102, 103, 104, 105, 106, 107, 108],
            "Student": [
                "Sharwari", "Ritika", "Bhumika", "Kunali",
                "Nandini", "Sneha", "Parth", "Arnav"
            ],
            "Branch": [
                "CSE", "CSE", "ECE", "CSE",
                "ECE", "IT", "IT", "CSE"
            ],
            "Mathematics": [85, 78, 92, np.nan, 67, 88, 74, 95],
            "Python": [90, 82, 89, 76, np.nan, 91, 70, 94],
            "Data Science": [88, 79, 95, 80, 72, 93, 75, np.nan]
        })

        self.attendance_data = pd.DataFrame({
            "Student ID": [101, 102, 103, 104, 105, 106, 107, 108],
            "Attendance %": [92, 85, 96, 78, 81, 94, 76, 98]
        })

    # --------------------------------------------------------
    # DATA CLEANING
    # --------------------------------------------------------

    def cleaned_data(self):

        df = self.student_data.copy()

        subjects = [
            "Mathematics",
            "Python",
            "Data Science"
        ]

        for subject in subjects:
            df[subject] = df[subject].fillna(
                df[subject].mean()
            )

        return df

    # --------------------------------------------------------
    # AVERAGE CALCULATION
    # --------------------------------------------------------

    def add_average(self):

        df = self.cleaned_data()

        df["Average"] = df[
            ["Mathematics", "Python", "Data Science"]
        ].mean(axis=1)

        return df

    # --------------------------------------------------------
    # LIST COMPREHENSION
    # --------------------------------------------------------

    def list_demo(self):

        scores = [85, 72, 91, 64, 88, 95, 76]

        return [
            score for score in scores
            if score >= 80
        ]

    # --------------------------------------------------------
    # DICTIONARY COMPREHENSION
    # --------------------------------------------------------

    def dictionary_demo(self):

        marks = {
            "Mathematics": 85,
            "Python": 90,
            "Data Science": 88
        }

        return {
            subject: marks[subject] + 5
            for subject in marks
        }

    # --------------------------------------------------------
    # NUMPY ARRAY
    # --------------------------------------------------------

    def numpy_array(self):

        return np.array([
            [85, 90, 88],
            [78, 82, 79],
            [92, 89, 95]
        ])

    # --------------------------------------------------------
    # NUMPY BROADCASTING
    # --------------------------------------------------------

    def numpy_broadcasting(self):

        values = self.numpy_array()

        return values + 5

    # --------------------------------------------------------
    # NUMPY VECTORIZATION
    # --------------------------------------------------------

    def numpy_vectorization(self):

        marks = np.array([70, 75, 80, 85, 90])

        return marks * 1.10

    # --------------------------------------------------------
    # GROUPBY ANALYSIS
    # --------------------------------------------------------

    def branch_analysis(self):

        df = self.add_average()

        return df.groupby(
            "Branch"
        )["Average"].mean()

    # --------------------------------------------------------
    # MERGE DATA
    # --------------------------------------------------------

    def combined_data(self):

        return pd.merge(
            self.student_data,
            self.attendance_data,
            on="Student ID"
        )


